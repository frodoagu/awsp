#!/usr/bin/env bash
# awsp-sync: rebuild the awsp profile inventory from the Okta tiles defined
# in ~/.saml2aws (every section except [default]).
#
#   awsp-sync            # all tiles
#   awsp-sync my-tile    # only some (rows from the other tiles are kept)
#
# Writes ~/.config/awsp/profiles.tsv and a managed block in ~/.aws/config.
set -euo pipefail

SAML_CFG=${SAML2AWS_CONFIGFILE:-$HOME/.saml2aws}
AWS_CFG=${AWS_CONFIG_FILE:-$HOME/.aws/config}
AWSP_DIR=${AWSP_DIR:-$HOME/.config/awsp}
DB=$AWSP_DIR/profiles.tsv
REGION=${AWSP_DEFAULT_REGION:-us-east-1}
BEGIN_MARK='# >>> awsp managed (generated by awsp-sync, do not edit) >>>'
END_MARK='# <<< awsp managed <<<'

tiles=("$@")
if ((${#tiles[@]} == 0)); then
  mapfile -t tiles < <(sed -n 's/^\[\(.*\)\][[:space:]]*$/\1/p' "$SAML_CFG" | grep -vx default)
fi
((${#tiles[@]})) || { echo "awsp-sync: no tiles found in $SAML_CFG" >&2; exit 1; }

mkdir -p "$AWSP_DIR"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# When syncing only some tiles, keep the rows of the others.
if (($#)) && [[ -s $DB ]]; then
  awk -F'\t' -v keep=" $* " 'index(keep, " " $2 " ") == 0' "$DB" >"$tmp/rows"
else
  : >"$tmp/rows"
fi

for tile in "${tiles[@]}"; do
  echo "==> [$tile] listing roles (first time with this tile? type the password: an empty Enter fails)"
  # `script` gives saml2aws a TTY (so prompts work) while saving its output.
  if ! script -qec "saml2aws list-roles -a $(printf '%q' "$tile")" "$tmp/$tile.log"; then
    echo "awsp-sync: list-roles failed for $tile, skipping" >&2
    continue
  fi
  tr -d '\r' <"$tmp/$tile.log" | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' |
    awk -v tile="$tile" '
      /^Account: / {
        label = substr($0, 10)
        if (match(label, / \([0-9]+\)[[:space:]]*$/)) label = substr(label, 1, RSTART - 1)
        next
      }
      /^arn:aws:iam::[0-9]+:role\// {
        arn = $1
        split(arn, p, ":"); acct = p[5]
        role = arn; sub(/.*\//, "", role)
        if (label == "" || label ~ /^[0-9]+$/) label = acct
        prof = tolower(label "-" role)
        gsub(/[^a-z0-9]+/, "-", prof); gsub(/^-|-$/, "", prof)
        print prof "\t" tile "\t" arn "\t" acct "\t" label
      }' >>"$tmp/rows"
done

# Same name and same ARN from two tiles: the first one wins.
# Same name with a different ARN: the tile is appended as a suffix.
awk -F'\t' -v OFS='\t' '
  ($1 in arn) { if (arn[$1] == $3) next; $1 = $1 "-" $2 }
  { arn[$1] = $3; print }' "$tmp/rows" | sort -t$'\t' -k1,1 >"$tmp/db"

if [[ ! -s $tmp/db ]]; then
  echo "awsp-sync: no roles found; leaving everything untouched" >&2
  exit 1
fi
mv "$tmp/db" "$DB"

# Managed block in ~/.aws/config (region only; saml2aws writes the credentials).
# Markers are matched by prefix so blocks written by older versions are replaced too.
touch "$AWS_CFG"
awk 'index($0, "# >>> awsp managed") == 1 {skip = 1; next}
  index($0, "# <<< awsp managed") == 1 {skip = 0; next}
  !skip' "$AWS_CFG" >"$tmp/config.base"
{
  cat "$tmp/config.base"
  echo "$BEGIN_MARK"
  while IFS=$'\t' read -r prof _; do
    if grep -qxF "[profile $prof]" "$tmp/config.base"; then
      echo "awsp-sync: [profile $prof] already exists outside the block, not duplicating it" >&2
      continue
    fi
    printf '[profile %s]\nregion = %s\n' "$prof" "$REGION"
  done <"$DB"
  echo "$END_MARK"
} >"$tmp/config.new"
if ! cmp -s "$tmp/config.new" "$AWS_CFG"; then
  cp "$AWS_CFG" "$AWS_CFG.bak.awsp"
  cat "$tmp/config.new" >"$AWS_CFG"
fi

echo
echo "$(wc -l <"$DB") profiles in $DB:"
column -t -s$'\t' "$DB"
