# ~/.saml2aws: one section per AWS tile in Okta.
# awsp-sync walks every section except [default].
# Each tile's URL is the link shown when hovering the tile on the Okta dashboard.

[team-a]
name                 = team-a
url                  = https://example.okta.com/home/amazon_aws/0oaXXXXXXXXXXXXXXXXX/272
username             = user@example.com
provider             = Okta
mfa                  = TOTP
aws_urn              = urn:amazon:webservices
# Default requested duration; if a role allows less, awsp looks up its maximum and remembers it.
aws_session_duration = 28800
region               = us-east-1
# Reuse the SAML assertion for a few minutes: switch roles without repeating MFA.
# Use a separate cache file per tile.
saml_cache           = true
saml_cache_file      = /home/user/.aws/saml_cache_team-a.xml

[team-b]
name                 = team-b
url                  = https://example.okta.com/home/amazon_aws/0oaYYYYYYYYYYYYYYYYY/272
username             = user@example.com
provider             = Okta
mfa                  = TOTP
aws_urn              = urn:amazon:webservices
aws_session_duration = 28800
region               = us-east-1
saml_cache           = true
saml_cache_file      = /home/user/.aws/saml_cache_team-b.xml
